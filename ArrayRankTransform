import java.util.*;

public class Main {

    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();

        int[] arr = new int[n];

        for(int i = 0; i < n; i++) {
            arr[i] = sc.nextInt();
        }

        int[] temp = arr.clone();

        Transform(arr, temp, n);

        System.out.println(Arrays.toString(arr));
    }

    public static void Transform(int[] arr, int[] temp, int n) {

        Arrays.sort(temp);

        for(int i = 0; i < n; i++) {

            for(int j = 0; j < n; j++) {

                if(arr[i] == temp[j]) {
                    arr[i] = j + 1;
                    break;
                }
            }
        }
    }
}
