 import java.util.*;
import java.util.Scanner;
public class Main{
    public static void main(String args[]){
        Scanner sc = new Scanner(System.in);
        String s = sc.nextLine();
        String normal = "";
        String special = ""; 
        for(int i = 0 ; i < s.length() ; i++){
            char ch = s.charAt(i);
            if(Character.isLetterOrDigit(ch)){
                normal += ch ;
            }
            else {
                special += ch ;
            }
        }
        System.out.println(normal + special) ;
    }

}
